{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist", "playwright-report", "test-results", "lighthouse/reports", "public/mockServiceWorker.js"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": { "react/rules-of-hooks": "off", "react-hooks/rules-of-hooks": "off" }
    },
    {
      "files": ["src/components/ui/**", "src/router.tsx", "src/realtime/hooks.tsx", "src/components/layout/root-layout.tsx"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
