# Ativa a API simulada (MSW REST + Socket.IO). "false" desliga os mocks.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (Axios).
VITE_API_URL=/api
# Endpoint Socket.IO (interceptado pelo MSW quando os mocks estão ativos).
VITE_REALTIME_URL=wss://realtime.kurio.mock
# Timeout (ms) da criação de pedido no cliente.
VITE_ORDER_TIMEOUT_MS=8000
